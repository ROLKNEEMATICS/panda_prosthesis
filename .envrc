use flake .#panda-prosthesis-full-devel
export LD_LIBRARY_PATH="$(pwd)/.superbuild/install/lib:$(pwd)/.superbuild/lib64:$LD_LIBRARY_PATH"

if [[ "$(hostname)" == "idh-msi-dragon" ]]; then
  bin_dir=".direnv/bin"
  mkdir -p "$bin_dir"

  # Create a wrapper script that filters itself out of PATH to prevent loops
  cat << 'EOF' > "$bin_dir/mc-rtc-magnum"
#!/usr/bin/env bash

# Strip .direnv/bin from PATH so nixgl finds the real flake binary, not this wrapper
new_path=""
IFS=':' read -ra ADDR <<< "$PATH"
for i in "${ADDR[@]}"; do
    if [[ "$i" != *"/.direnv/bin"* ]]; then
        new_path="${new_path:+$new_path:}$i"
    fi
done
export PATH="$new_path"

# Run through nixgl
exec nix run --impure github:nix-community/nixgl -- nix run .#mc-rtc-magnum "$@"
EOF

  chmod +x "$bin_dir/mc-rtc-magnum"

  PATH_add "$bin_dir"
  echo "Set recursive-safe nixgl wrapper for mc-rtc-magnum"
fi
